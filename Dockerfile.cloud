# Brahma Echo Cloud Brain — Docker Container
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies + Node.js (for God's Eye View 3D Recon)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ffmpeg \
    ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements-cloud.txt .
RUN pip install --no-cache-dir -r requirements-cloud.txt

# Copy application files
COPY cloud/ ./cloud/
COPY core/ ./core/
COPY memory/ ./memory/
COPY config/ ./config/
COPY gods-eye-view-main/ ./gods-eye-view-main/
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN cd gods-eye-view-main && npm install --no-audit
COPY cloud_server.py .
COPY telegram_bot.py .

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=8000
ENV HOST=0.0.0.0

EXPOSE 8000

CMD ["sh", "-c", "python cloud_server.py --host 0.0.0.0 --port ${PORT:-8000}"]
